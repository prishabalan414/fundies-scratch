use context starter2024
(12 * 3) * 5
(12 * 3) * 7
(2 * (420 + 594)) * 0.10

"Designs for everyone!"
"red" + "blue"


rectangle(40, 100, "solid", "black")
yellowlight = above(circle(15, "solid", "yellow"),
  circle(15, "solid", "green"))
above(circle(15, "solid", "red"), yellowlight) 
overlay(above(circle(15, "solid", "red"),yellowlight), rectangle(40, 100, "solid", "black"))

rotate(180, overlay(above(circle(15, "solid", "red"),yellowlight), rectangle(40, 100, "solid", "black")))




